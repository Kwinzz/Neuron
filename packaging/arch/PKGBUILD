# Neuron — Arch Linux package built from the sources of this repository.
# From a clone:  cd packaging/arch && makepkg -si
pkgname=neuron
pkgver=0.2.5
pkgrel=1
pkgdesc="Desktop cockpit for command-line AI agents (Claude Code, Codex, Antigravity)"
arch=('x86_64' 'aarch64')
url="https://github.com/Kwinzz/Neuron"
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'openssl' 'hicolor-icon-theme')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'git' 'mold')
optdepends=(
  'claude-code: Claude Code agent (or the Install button in Neuron)'
  'libnotify: desktop notifications'
  'kitty: terminal opened to install / sign in to the agents (or alacritty, konsole, gnome-terminal…)'
)
options=('!lto' '!debug')
# Nothing to download: the repository containing this PKGBUILD is built.
source=()
sha256sums=()

_root() { realpath "$startdir/../.."; }

pkgver() {
  sed -n 's/^\s*"version": "\(.*\)",/\1/p' "$(_root)/src-tauri/tauri.conf.json" | head -n1
}

build() {
  cd "$(_root)"
  export CARGO_TARGET_DIR="$srcdir/target"
  # No LTO, incremental build, mold when available (see the file).
  # shellcheck disable=SC1091
  . "$(_root)/packaging/linux-build-env.sh"
  neuron_npm_ci
  npm run tauri build -- --no-bundle
}

package() {
  local root
  root="$(_root)"
  install -Dm755 "$srcdir/target/release/neuron" "$pkgdir/usr/bin/neuron"
  install -Dm644 "$startdir/neuron.desktop" "$pkgdir/usr/share/applications/neuron.desktop"
  install -Dm644 "$root/src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/neuron.png"
  install -Dm644 "$root/src-tauri/icons/64x64.png" "$pkgdir/usr/share/icons/hicolor/64x64/apps/neuron.png"
  install -Dm644 "$root/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/neuron.png"
  install -Dm644 "$root/src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/neuron.png"
  install -Dm644 "$root/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/neuron.png"
}
