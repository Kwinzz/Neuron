{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neuron",
  "version": "0.2.0",
  "identifier": "dev.neuron.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Neuron",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0A0A0A",
        "theme": "Dark",
        "visible": false
      },
      {
        "label": "quick",
        "title": "Neuron — quick prompt",
        "width": 680,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Neuron",
    "copyright": "© 2026 Neuron",
    "category": "DeveloperTool",
    "shortDescription": "Desktop cockpit for your command-line AI agents",
    "longDescription": "Neuron drives Claude Code, Antigravity, Codex and other AI agent CLIs from a single interface: chats, shared memory, quotas, notifications and a quick prompt from any app.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Neuron",
        "installerHooks": "installer/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
